# Text is stored and checked out with LF line endings on every platform, so
# a Windows checkout reads the same bytes the tests and the workers do.
* text=auto eol=lf

# The upstream roots.json documents and the tree that lists them are the exact
# bytes of the Comet repository, final newline or none: the registry checks a
# root against the git object id the tree gives for it, so a checkout must
# never convert them.
c3-api/tests/fixtures/registry/source/** -text
